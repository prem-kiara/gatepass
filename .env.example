# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=3040
NODE_ENV=production

# --- Database ---
DATABASE_URL=postgres://gatepass:CHANGE_ME@127.0.0.1:5432/gatepass

# --- Auth ---
# Generate with: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Cookies are marked Secure unless this is explicitly "false" (local http dev).
COOKIE_SECURE=true

# --- Photos ---
# Directory must be writable by the app user. Include it in the VM backup routine.
PHOTO_DIR=/var/gatepass/photos

# --- Seed (idempotent; only creates the account if the username is absent) ---
SEED_ADMIN_USER=superadmin
SEED_ADMIN_PASS=CHANGE_ME
SEED_ADMIN_NAME=Super Admin
